# สร้างจาก Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ใช้เฉพาะฝั่ง server เท่านั้น ห้ามนำไปใส่ใน NEXT_PUBLIC_ และห้าม commit ค่าจริง
SUPABASE_SECRET_KEY=\nSUPABASE_SERVICE_ROLE_KEY=

# Meta Pages API — เติมหลังสร้าง Meta App และตั้ง Facebook Login for Business
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/meta/callback
# base64 ของ random 32 bytes; สร้างด้วย `openssl rand -base64 32` และเก็บเฉพาะใน server environment
META_TOKEN_ENCRYPTION_KEY=

